# WarcraftLogs API (https://www.warcraftlogs.com/api/clients)
# Create a client application and get client_id + client_secret
WCL_CLIENT_ID=your_warcraftlogs_client_id
WCL_CLIENT_SECRET=your_warcraftlogs_client_secret

# Anthropic / Claude API (https://console.anthropic.com)
# Required for AI analyst summaries - falls back to template summary if missing
ANTHROPIC_API_KEY=your_anthropic_api_key
