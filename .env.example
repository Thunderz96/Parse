# WarcraftLogs API (https://www.warcraftlogs.com/api/clients)
WCL_CLIENT_ID=your_warcraftlogs_client_id
WCL_CLIENT_SECRET=your_warcraftlogs_client_secret

# Anthropic / Claude API (https://console.anthropic.com)
# Falls back to template summary if missing
ANTHROPIC_API_KEY=your_anthropic_api_key

# PostgreSQL database — get a free one at https://neon.tech or https://supabase.com
# Format: postgresql://user:password@host/dbname?sslmode=require
# App works without this but historical charts will show simulated data
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cron job secret — any random string, must match what Vercel sends
CRON_SECRET=any_random_secret_string
